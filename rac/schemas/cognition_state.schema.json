{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RACCognitionState",
  "type": "object",
  "required": [
    "question",
    "question_type",
    "domain",
    "factors",
    "factor_weights",
    "evidence_packets",
    "hypotheses",
    "critic_findings",
    "fact_check",
    "belief_update",
    "final_report"
  ],
  "properties": {
    "question": {
      "type": "string"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "factual",
        "causal_diagnostic",
        "strategic_recommendation",
        "comparability_judgment",
        "technical_design",
        "philosophical"
      ]
    },
    "domain": {
      "type": "string"
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      }
    },
    "factor_weights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor_weight"
      }
    },
    "evidence_packets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_packet"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "critic_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/critic_finding"
      }
    },
    "fact_check": {
      "type": "object",
      "required": [
        "status",
        "unsupported_claims",
        "definition_conflicts"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "pass_with_warnings",
            "fail"
          ]
        },
        "unsupported_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definition_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "belief_update": {
      "$ref": "#/$defs/belief_update"
    },
    "final_report": {
      "type": "string"
    }
  },
  "$defs": {
    "factor": {
      "type": "object",
      "required": [
        "factor_id",
        "name",
        "description",
        "evidence_needed"
      ],
      "properties": {
        "factor_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "evidence_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "factor_weight": {
      "type": "object",
      "required": [
        "factor_id",
        "weight",
        "weight_reason",
        "evidence_status"
      ],
      "properties": {
        "factor_id": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weight_reason": {
          "type": "string"
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "supported",
            "partially_supported",
            "missing",
            "contradicted"
          ]
        }
      }
    },
    "evidence_packet": {
      "type": "object",
      "required": [
        "evidence_id",
        "source_type",
        "source_path",
        "claim_supported",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "markdown",
            "csv",
            "sql_output",
            "memory",
            "web",
            "manual_note"
          ]
        },
        "source_path": {
          "type": "string"
        },
        "claim_supported": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "hypothesis_id",
        "claim",
        "confidence",
        "supporting_factors",
        "weaknesses",
        "status"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "supporting_factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "strong",
            "plausible",
            "weak",
            "unsupported",
            "rejected"
          ]
        }
      }
    },
    "critic_finding": {
      "type": "object",
      "required": [
        "issue",
        "severity",
        "recommendation"
      ],
      "properties": {
        "issue": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "recommendation": {
          "type": "string"
        }
      }
    },
    "belief_update": {
      "type": "object",
      "required": [
        "belief_id",
        "claim",
        "confidence",
        "status",
        "validity_conditions",
        "limitations"
      ],
      "properties": {
        "belief_id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "tentative",
            "deprecated",
            "rejected"
          ]
        },
        "validity_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
